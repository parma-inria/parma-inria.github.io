{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ParMA: genera il sito",
      "type": "process",
      "command": "python",
      "args": ["tools/build.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "ParMA: anteprima locale",
      "type": "process",
      "command": "python",
      "args": ["tools/preview.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "ParMA: controlla il sito",
      "type": "process",
      "command": "python",
      "args": ["tools/check.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "dependsOn": "ParMA: genera il sito",
      "problemMatcher": []
    }
  ]
}
