{
  "files.encoding": "utf8",
  "files.insertFinalNewline": true,
  "files.eol": "\n",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.wordWrap": "on",
  "files.exclude": {
    "public": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "content/translations/fr.json": true,
    "content/translations/it.json": true,
    "tools/translation-memory.json": true
  },
  "search.exclude": {
    "public": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "content/translations/fr.json": true,
    "content/translations/it.json": true,
    "tools/translation-memory.json": true,
    "docs/sources": true
  },
  "[python]": {
    "editor.tabSize": 4
  }
}
